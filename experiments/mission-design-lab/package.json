{
  "name": "missao-ipe-mission-lab",
  "version": "0.10.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Jogo educacional de engenharia de missões espaciais com dados históricos NASA, laboratório de física e hangar R3F.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-science-records.mjs && npm run build:research && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "test:ui": "node scripts/test-ui.mjs",
    "verify": "npm run test && npm run test:ui && npm run build",
    "build:research": "node scripts/build-research.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
