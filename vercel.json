    {
      "source": "/architecture",
      "destination": "/architecture/index.html",
      "permanent": false
    },
    {
      "source": "/arquitetura",
      "destination": "/architecture/index.html",
      "permanent": false
    },
    {
      "source": "/pitch",
      "destination": "https://missao-ipe-central-ab.alexandrebelo.chatgpt.site/",
      "permanent": false
    },
    {
      "source": "/equipe",
      "destination": "/equipe/index.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html",
