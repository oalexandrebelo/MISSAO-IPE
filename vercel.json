      "source": "/doc",
      "destination": "/docs/index.html",
      "permanent": false
    },
    {
      "source": "/painel",
      "destination": "/dashboard/index.html",
      "permanent": false
    },
    {
      "source": "/campanha/research",
      "destination": "/campanha/research/index.html",
