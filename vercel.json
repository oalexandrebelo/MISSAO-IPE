{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jogo.nasa-missaoipe.alexandrebelo.com"
        }
      ],
      "destination": "https://nasa-missaoipe.alexandrebelo.com/lab/index.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jogo.nasa-missaoipe.alexandrebelo.com"
        }
      ],
      "destination": "https://nasa-missaoipe.alexandrebelo.com/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pitch.nasa-missaoipe.alexandrebelo.com"
        }
      ],
      "destination": "https://missao-ipe-central-ab.alexandrebelo.chatgpt.site/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pitch.nasa-missaoipe.alexandrebelo.com"
        }
      ],
      "destination": "https://nasa-missaoipe.alexandrebelo.com/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "painel.nasa-missaoipe.alexandrebelo.com"
        }
      ],
      "destination": "https://nasa-missaoipe.alexandrebelo.com/dashboard/index.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "painel.nasa-missaoipe.alexandrebelo.com"
        }
      ],
      "destination": "https://nasa-missaoipe.alexandrebelo.com/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.nasa-missaoipe.alexandrebelo.com"
        }
